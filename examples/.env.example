# Public app URLs
N8N_PUBLIC_URL=https://n8n.yourdomain.com
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/your-webhook-path
ADMIN_DASHBOARD_URL=https://admin.yourdomain.com

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta / Instagram
META_APP_ID=your-meta-app-id
META_VERIFY_TOKEN=your-random-webhook-verify-token
INSTAGRAM_ACCESS_TOKEN=your-long-lived-access-token
INSTAGRAM_ACCOUNT_ID=your-instagram-business-account-id

# Optional runtime settings
DM_BATCH_SIZE=6
DM_WORKER_INTERVAL_MINUTES=2
DM_HOURLY_LIMIT=180
