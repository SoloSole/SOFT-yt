        "jsonBody": "={{ JSON.stringify({ recipient: { id: $json.senderId }, message: { attachment: { type: 'template', payload: { template_type: 'button', text: $json.followerCheckMsg, buttons: [{ type: 'postback', title: 'Check again', payload: $json.postbackPayload }] } } } }) }}",
        "options": {}
      },
