      "name": "Webhook Events (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 224],
      "webhookId": "instagram-webhook"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {"responseCode": 200}
      },
      "id": "a22e1d7e-7b7b-41e8-9438-68ba1352cb6d",
      "name": "Respond Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [224, 0]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK",
        "options": {"responseCode": 200}
      },
      "id": "796bc262-4b6a-4b32-be37-29e92164e0cd",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [224, 224]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nlet eventType = 'unknown';\nlet commentText = '';\nlet commentId = '';\nlet senderId = '';\nlet senderUsername = '';\nlet mediaId = '';\nlet postbackPayload = '';\nlet igAccountId = '';\n\n// Public template note:\n// Store account tokens in Supabase `ig_accounts.access_token`.\n// Do not hardcode tokens in this node.\n\ntry {\n  const entry = body.entry?.[0];\n  igAccountId = entry?.id || '';\n  const change = entry?.changes?.[0];\n  const messaging = entry?.messaging?.[0];\n  if (change?.field === 'comments') {\n    eventType = 'comment';\n    commentText = change.value?.text || '';\n    commentId = change.value?.id || '';\n    senderId = change.value?.from?.id || '';\n    if (senderId === igAccountId) {\n      eventType = 'own_comment';\n    }\n    senderUsername = change.value?.from?.username || '';\n    mediaId = change.value?.media?.id || '';\n  } else if (messaging?.postback) {\n    eventType = 'postback';\n    postbackPayload = messaging.postback.payload || '';\n    senderId = messaging.sender?.id || '';\n  } else if (messaging?.message && !messaging.message.is_echo) {\n    eventType = 'dm';\n    commentText = messaging.message.text || '';\n    senderId = messaging.sender?.id || '';\n  }\n} catch(e) {}\n\nreturn [{ json: {\n  eventType,\n  commentText: commentText.toLowerCase().trim(),\n  commentTextRaw: commentText,\n  commentId,\n  senderId,\n  senderUsername,\n  mediaId,\n  postbackPayload,\n  igAccountId\n}}];"
      },
      "id": "b604b872-83aa-4817-952b-bea5e746969f",
      "name": "Parse Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [384, 224]
    },
    {
      "parameters": {
        "operation": "get",
        "tableId": "ig_accounts",
        "filters": {"conditions": [{"keyName": "ig_user_id", "keyValue": "={{ $json.igAccountId }}"}]}
      },
      "id": "fe6f2f0c-7863-4a8d-b533-e5eea2ff7cf9",
      "name": "Get Account",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [592, 224],
      "credentials": {"supabaseApi": {"id": "YOUR_SUPABASE_CREDENTIAL_ID", "name": "YOUR_SUPABASE_CREDENTIAL_NAME"}}
    },
    {
      "parameters": {"conditions": {"string": [{"value1": "={{ $('Parse Event').first().json.eventType }}", "value2": "comment"}]}},
      "id": "43eb07cf-18a9-4182-ba46-644de7530e13",
      "name": "Is Comment?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [816, 224]
    },
    {
      "parameters": {"conditions": {"string": [{"value1": "={{ $('Parse Event').first().json.eventType }}", "value2": "postback"}]}},
      "id": "3a461efa-b56a-4c7a-afbb-49e4a0b4bf37",
      "name": "Is Postback?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1040, 400]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "kw_flows",
        "returnAll": true,
        "filterType": "string",
        "filterString": "active=eq.true"
      },
      "id": "b74b4393-3cdd-4346-9dbc-ad1d90cceddb",
      "name": "Get KW Flows",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1040, 64],
      "credentials": {"supabaseApi": {"id": "YOUR_SUPABASE_CREDENTIAL_ID", "name": "YOUR_SUPABASE_CREDENTIAL_NAME"}}
    },
    {
      "parameters": {
        "jsCode": "const eventData = $('Parse Event').first().json;\nconst accountData = $('Get Account').first().json;\nconst flows = $input.all().map(i => i.json);\nlet matchedFlow = null;\nfor (const flow of flows) {\n  const kw = flow.keyword.toLowerCase().trim();\n  const text = eventData.commentText;\n  if (flow.match_type === 'exact') {\n    if (text === kw) { matchedFlow = flow; break; }\n  } else {\n    if (text.includes(kw)) { matchedFlow = flow; break; }\n  }\n}\nif (!matchedFlow) return [{ json: { matched: false } }];\nconst igUsername = matchedFlow.ig_username || accountData.username || 'your_username';\nconst replyText = matchedFlow.reply_text || ('Sending you the link via DM! Follow @' + igUsername + ' for more');\nconst btnTitle = matchedFlow.output_type === 'pdf' ? 'Open PDF' : 'Open Link';\nconst followerGateDm = accountData.follower_gate_dm || 'Get content';\nreturn [{ json: {\n  matched: true,\n  flow: matchedFlow,\n  senderId: eventData.senderId,\n  commentId: eventData.commentId,\n  igAccountId: eventData.igAccountId,\n  accessToken: accountData.access_token,\n  replyText,\n  btnTitle,\n  outputValue: matchedFlow.output_value,\n  followerOnly: true,\n  followerGateDm\n}}];"
      },
      "id": "8fff165a-d37c-4a63-b62c-2a21de499618",
      "name": "Match KW",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1264, 64]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "dm_queue",
        "returnAll": true,
        "filterType": "string",
        "filterString": "={{ 'comment_id=eq.' + $json.commentId }}"
      },
      "id": "0522fad7-6bca-47db-8d61-a067e0dd50f4",
      "name": "Dedupe Check",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1488, 64],
      "alwaysOutputData": true,
      "credentials": {"supabaseApi": {"id": "YOUR_SUPABASE_CREDENTIAL_ID", "name": "YOUR_SUPABASE_CREDENTIAL_NAME"}}
    },
    {
      "parameters": {
        "conditions": {"boolean": [{"value1": "={{ $('Match KW').first().json.matched }}", "value2": true}, {"value1": "={{ $input.all().filter(i => i.json.id).length === 0 }}", "value2": true}]}
      },
      "id": "381852c3-93f8-4e81-bd39-cb40c84f0acc",
      "name": "KW Matched?",
      "type": "n8n-nodes-base.if",
