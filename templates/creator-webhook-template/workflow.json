          {"fieldId": "sender_id", "fieldValue": "={{ $('Match KW').first().json.senderId }}"},
          {"fieldId": "comment_id", "fieldValue": "={{ $('Match KW').first().json.commentId }}"},
          {"fieldId": "ig_account_id", "fieldValue": "={{ $('Match KW').first().json.igAccountId }}"},
          {"fieldId": "access_token", "fieldValue": "={{ $('Match KW').first().json.accessToken }}"},
          {"fieldId": "dm_text", "fieldValue": "={{ $('Match KW').first().json.followerGateDm }}"},
          {"fieldId": "btn_title", "fieldValue": "={{ $('Match KW').first().json.followerGateDm }}"},
          {"fieldId": "output_value", "fieldValue": "={{ $('Match KW').first().json.outputValue }}"},
          {"fieldId": "status", "fieldValue": "pending"},
          {"fieldId": "follower_only", "fieldValue": "={{ $('Match KW').first().json.followerOnly }}"},
          {"fieldId": "reply_text", "fieldValue": "={{ $('Match KW').first().json.replyText }}"}
        ]}
      },
      "id": "5d84efe3-dbd8-4fe1-9f72-75d12d97e9bc",
      "name": "Add to Queue",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1936, 64],
      "credentials": {"supabaseApi": {"id": "YOUR_SUPABASE_CREDENTIAL_ID", "name": "YOUR_SUPABASE_CREDENTIAL_NAME"}}
    },
    {
      "parameters": {
        "tableId": "dm_logs",
        "fieldsUi": {"fieldValues": [
          {"fieldId": "ig_user_id", "fieldValue": "={{ $('Match KW').first().json.senderId || '' }}"},
          {"fieldId": "keyword_matched", "fieldValue": "={{ $('Match KW').first().json.flow?.keyword || '' }}"},
          {"fieldId": "output_sent", "fieldValue": "={{ $('Match KW').first().json.outputValue || '' }}"},
          {"fieldId": "is_follower", "fieldValue": false},
          {"fieldId": "comment_id", "fieldValue": "={{ $('Match KW').first().json.commentId || '' }}"}
        ]}
      },
      "id": "d306d2d9-3be3-4cf0-b28a-9c5d6e8584f4",
      "name": "Log to Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2160, 64],
      "credentials": {"supabaseApi": {"id": "YOUR_SUPABASE_CREDENTIAL_ID", "name": "YOUR_SUPABASE_CREDENTIAL_NAME"}}
    },
    {
      "parameters": {
        "url": "={{ 'https://graph.instagram.com/v21.0/' + $('Parse Event').first().json.senderId + '?fields=is_user_follow_business&access_token=' + $('Get Account').first().json.access_token }}",
        "options": {}
      },
      "id": "82bd1d54-5d2a-4e08-83ff-cd4276d9aec4",
      "name": "Check Follower",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1264, 400]
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst parseData = $('Parse Event').first().json;\nconst accountData = $('Get Account').first().json;\nconst isFollower = result.is_user_follow_business === true;\nreturn [{ json: {\n  isFollower,\n  senderId: parseData.senderId,\n  igAccountId: parseData.igAccountId,\n  accessToken: accountData.access_token,\n  postbackPayload: parseData.postbackPayload,\n  followerCheckMsg: accountData.follower_check_msg || 'This content is for followers only. Follow and click again!',\n  followerSuccessMsg: accountData.follower_success_msg || 'Here is your link.'\n}}];"
      },
      "id": "c1d791aa-f420-4b54-819d-51cb25ec3852",
      "name": "Parse Follower",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1488, 400]
    },
    {
      "parameters": {"conditions": {"boolean": [{"value1": "={{ $json.isFollower }}", "value2": true}]}},
      "id": "4ca07b73-c1f9-4b06-95e6-1fc5ed446071",
      "name": "Is Follower?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1712, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.instagram.com/v21.0/' + $json.igAccountId + '/messages' }}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $json.accessToken }}"}, {"name": "Content-Type", "value": "application/json"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ recipient: { id: $json.senderId }, message: { attachment: { type: 'template', payload: { template_type: 'button', text: $json.followerSuccessMsg, buttons: [{ type: 'web_url', url: $json.postbackPayload, title: 'Open Link' }] } } } }) }}",
        "options": {}
      },
      "id": "6552f87c-65ad-4f2c-9cc0-b04ff317e66a",
